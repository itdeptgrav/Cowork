# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Signs the session cookie. Must be at least 32 chars.
# A production build without it refuses to sign sessions and the proxy fails
# closed, so every request is treated as anonymous — deliberately, rather than
# silently trusting a secret that is in the repository.
#   Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COWORK_SESSION_SECRET=

# Optional. Where the identity store writes accounts, organisations and
# sessions. Defaults to ./.data/identity.json — see lib/server/store.ts for why
# that adapter is single-node only.
# COWORK_IDENTITY_PATH=/var/lib/cowork/identity.json

# ── Legacy Cowork system (adapter layer) ─────────────────────────────────────
# The new UI runs as a skin over the existing Cowork engine. These point it at
# the legacy backend; without them the adapter refuses to start rather than
# showing empty screens that read as "your company has no staff".

# Base URL of the legacy Express backend (cowork-old-backend).
NEXT_PUBLIC_LEGACY_API_URL=

# Firebase client configuration for the LEGACY project.
# Required, not optional: the legacy `verifyCoworkToken` middleware accepts
# only Firebase ID tokens, so signing in to legacy means running the Firebase
# client SDK. Copy these from the legacy frontend's own environment.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# FCM Web Push certificate — Firebase Console, Cloud Messaging, Web Push
# certificates. Registers this device for push so the notifications the engine
# sends reach a phone. Unset is fine: in-app notifications are unaffected and
# push simply stays off.
#
# NOT the VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY pair, which belongs to the
# store-side web-push path in NotificationService.js. Passing that public key
# here makes getToken fail with an unregistered-sender error that reads like a
# network fault.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-side only. Firebase Admin service-account JSON for the proxy routes,
# which perform the authorisation legacy omits (review-completion, change-role,
# change-department). Never expose this to the browser.
LEGACY_FIREBASE_SERVICE_ACCOUNT=

# MRF reference-photo uploads (Cloudinary). Signed is used when the secret is
# set; otherwise the unsigned preset is used.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=diiw4yavi
NEXT_PUBLIC_CLOUDINARY_API_KEY=761178377638612
CLOUDINARY_API_SECRET=yDvxdHECMbQbOl-d15odPx3O1eQ
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
